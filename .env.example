# ---------------------------------------------------------------------------
# Holy Sai Smart School 360 — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Supabase: use the *Session pooler* URI (Project Settings -> Database), not the
# direct db.<ref>.supabase.co host — that one is IPv6-only and unreachable from
# Render and most other PaaS hosts:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5544/holysai
# false (local) | true (verify the certificate) | no-verify (encrypt, skip
# verification — what managed hosts such as Supabase need by default)
DATABASE_SSL=false
# PEM of a CA bundle to trust, when DATABASE_SSL=true
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

# JWT — use long random values (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=holysai-api
JWT_AUDIENCE=holysai-clients

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Cookie settings for the web refresh token (set COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_MAX=20

# Uploads (stored outside the web root; served only through authorised API routes)
# local    — files under UPLOAD_DIR. Development, or a host with a mounted disk.
# supabase — a private Supabase Storage bucket. Use this on any host with an
#            ephemeral filesystem (Render, Fly, Heroku), where local uploads are
#            lost on every deploy and restart.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# Required when STORAGE_DRIVER=supabase. The service role key is server-side
# only — it bypasses row-level security, so never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Maps — Leaflet + OpenStreetMap needs no key. Set these to switch tile provider.
# GPS devices (POST /api/v1/location). Device tokens need no extra secret: only their SHA-256 is stored.
LOCATION_INTERVAL_SECONDS=30
ONLINE_THRESHOLD_SECONDS=120
OFFLINE_THRESHOLD_SECONDS=600
LOCATION_MAX_FUTURE_SECONDS=300
LOCATION_MAX_AGE_HOURS=72
DEVICE_RATE_LIMIT_PER_MINUTE=30

MAP_API_KEY=
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Seed data password for every demo account (development only)
SEED_DEMO_PASSWORD=

# Notification channels — leave blank to keep deliveries queued (no external calls)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_KEY=
SMTP_URL=
PUSH_FCM_SERVER_KEY=

# Paper Correction (exam-vision/ — Claude reads and marks handwritten answer sheets).
# The service runs on its own port; set the same secret there as EXAM_GATEWAY_SECRET.
# Leave EXAM_VISION_URL blank to switch the module off.
EXAM_VISION_URL=
EXAM_VISION_SECRET=

LOG_LEVEL=info

# Web dev server: where Vite forwards /api (default http://127.0.0.1:4000)
VITE_API_PROXY=
# Web build: absolute API base when the SPA is served from another origin (default /api)
VITE_API_BASE_URL=

# Automated tests use a separate database (default: <DATABASE_URL database>_test)
TEST_DATABASE_URL=
