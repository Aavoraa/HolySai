{
  "name": "@holysai/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../.env scripts/reset.ts",
    "db:top-up": "tsx --env-file-if-exists=../.env scripts/top-up-students.ts",
    "db:sample-files": "tsx --env-file-if-exists=../.env scripts/sample-document-files.ts",
    "test": "vitest run",
    "test:db": "tsx --env-file-if-exists=../.env scripts/test-db.ts",
    "docs:schema": "tsx --env-file-if-exists=../.env scripts/schema-doc.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
