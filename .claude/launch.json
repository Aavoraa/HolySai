{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "holysai-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "backend"],
      "port": 4000
    },
    {
      "name": "holysai-exam",
      "runtimeExecutable": "exam-vision/backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "exam-vision/backend", "--host", "127.0.0.1", "--port", "8006"],
      "port": 8006
    },
    {
      "name": "holysai-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "frontend"],
      "port": 5173
    },
    {
      "name": "holysai-wireframe",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5573", "--directory", "wireframe"],
      "port": 5573
    }
  ]
}
